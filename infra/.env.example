# Copy to infra/.env and fill in real values. Never commit the real file.
# These defaults are for local runs and CI only.
# The variables below follow the environment matrix in docs/designs/architecture.md;
# infra/docker-compose.yml passes each one only to the services the matrix names.

MODE=mock
DOMAIN=localhost

# Postgres (shared by the app, Keycloak and OpenFGA)
POSTGRES_USER=spinach
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=spinach

# Keycloak bootstrap admin
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-local

# Neo4j (password must be at least 8 characters)
NEO4J_PASSWORD=change-me-local

# Model provider (Phase 0 hello container, retired in build step 6)
MUSE_API_KEY=

# Real integrations (only used when MODE is not mock; docs/designs/adapters.md). DoorDash and
# Kroger have no real adapter yet (adapters.md §12), so their values are unused.
DOORDASH_DEVELOPER_ID=
DOORDASH_KEY_ID=
DOORDASH_SIGNING_SECRET=
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# --- Environment matrix (all app: api, agents, mcp, testrunner; plus migrate) ---
# DATABASE_URL and SERVICE_NAME are set per service by docker-compose.yml: DATABASE_URL is
# built from the POSTGRES_* values above and SERVICE_NAME is the service's own name.
LOG_LEVEL=INFO

# All app. Run overrides win.
APPROVAL_TTL_SECONDS=14400
RUN_TIMEOUT_SECONDS=300
QUOTE_ROUND_SECONDS=30

# api, testrunner. Per-vendor overrides of MODE; empty means "use MODE".
MODE_FORCE_MOCK=
MODE_KROGER_CATALOG=
MODE_KROGER_ORDERING=
MODE_SQUARE_RETAIL=
MODE_SQUARE_RESTAURANT=
MODE_DOORDASH=

# agents, testrunner.
MODEL_MODE=stub
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
MODEL_FALLBACK_BASE_URL=
MODEL_FALLBACK_NAME=
MODEL_FALLBACK_API_KEY=
# Placeholder until the real-model rehearsal (architecture Q2) sets it. Must not be empty.
RUN_TOKEN_CEILING=200000
MODEL_BUSINESS_NAME=Muse Glimmer
MODEL_BUSINESS_TIMEOUT_SECONDS=5
# Muse Glimmer is open-weight and not on the Meta Model API (#392). Point these at the
# OpenAI-compatible host that serves it (for example Baseten, OpenRouter, NVIDIA build or
# a self-hosted vLLM). The key may be empty for a self-hosted server. Empty URL: business
# agents use MODEL_BASE_URL and MODEL_API_KEY. Keep one replica warm for the demo: a cold
# start is longer than MODEL_BUSINESS_TIMEOUT_SECONDS and every choice falls back.
MODEL_BUSINESS_BASE_URL=
MODEL_BUSINESS_API_KEY=

# mcp, testrunner (NEO4J_PASSWORD is above)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
# mcp, migrate, testrunner. The store and model ids are read from fga_models
# (identity-authz §13); OPENFGA_STORE_ID is retired.
OPENFGA_API_URL=http://openfga:8080
KROGER_LOCATION_ID=

# --- Identity (docs/designs/identity-authz.md §13). "Live" means TOKEN_SOURCE is not mock.
# Empty counts as unset. PEM values are single-line base64.

# agents, api, mcp, testrunner. One of mock, keycloak, keycloak_azp, token_service.
TOKEN_SOURCE=mock
# agents, api, mcp, testrunner. Optional: empty derives https://${DOMAIN}/auth/realms/kitchenless
# (https://${DOMAIN}/tokens under token_service).
ISSUER_URL=
# agents, api, mcp, testrunner, in every mode. Fixed RSA key, public on purpose (I-D26):
# mcp accepts mock tokens only for eval households when TOKEN_SOURCE is not mock.
# TEST ONLY - never trusted for live households
MOCK_SIGNING_
# agents, api, mcp: required live. Internal URL, no round trip through Caddy.
KEYCLOAK_URL=http://keycloak:8080/auth
# agents, api: required live. Signs private_key_jwt client assertions.
# openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | base64 | tr -d '\n'
AGENT_SIGNING_KEY=
# api (required live) and keycloak. The certificate Keycloak stores on each client, as
# base64 DER (services/identity/realm/README.md):
# openssl req -x509 -key <key> -days 365 -subj /CN=agents -outform DER | base64 | tr -d '\n'
# CI dummy below: a self-signed certificate whose private key was discarded.
AGENT_SIGNING_
# agents, api: required live. Encrypts stored offline tokens.
# openssl rand -base64 32
GRANT_ENCRYPTION_KEY=
GRANT_KEY_VERSION=1
# api, required only when TOKEN_SOURCE=token_service.
# openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | base64 | tr -d '\n'
TOKEN_SERVICE_KEY=
# api (required live) and keycloak: the svc.onboarding client secret. Dummy for CI's
# --import-realm.
KC_ONBOARDING_SECRET=change-me-ci
# keycloak only: the seeded business owner's demo password. Dummy for CI's --import-realm.
OWNER_DEMO_PASSWORD=change-me-ci
# keycloak only: the seeded admins' phones, the realm usernames of US-1's members. They
# mirror SEED_US1_PHONES (testrunner, below). The realm import needs three distinct values
# (empty ones collide on the unique username), so these are fictional CI placeholders. On
# the VM, set the real phones before Keycloak first imports the realm: the import runs once.
SEED_US1_PHONE_1=+15550100001
SEED_US1_PHONE_2=+15550100002
SEED_US1_PHONE_3=+15550100003
# api, in every mode: signs the /me session cookie. CI dummy below.
# openssl rand -base64 32
SESSION_SECRET=change-me-ci
# agents, api, mcp, migrate, testrunner and openfga: OpenFGA's preshared key (I16c). CI dummy.
# openssl rand -base64 32
OPENFGA_PRESHARED_KEY=change-me-ci
# Compose only: the Keycloak image. Empty builds kitchenless-keycloak:local (make up, CI).
# The VM sets ghcr.io/street-spinach/kitchenless-keycloak:26.8.1-<sha8> (identity-authz §15).
KEYCLOAK_IMAGE=

# api
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# api (experience §9): the business's WhatsApp number (E.164) for join links; empty sends none.
WHATSAPP_NUMBER=
DOORDASH_WEBHOOK_PATH_SECRET=
# api (experience §5): approved Meta template names; empty means not approved.
WA_TPL_APPROVAL_REQUEST=
WA_TPL_TAKE_TURNS_OFFER=
WA_TPL_ORDER_SUMMARY=
WA_TPL_CONSENT_RENEWAL=
WA_TPL_CONSENT_REVOKED=
WA_TPL_REMINDER_DELIVERY_TODAY=
WA_TPL_REMINDER_PANTRY_SUMMARY=
# api (experience §11): 1 serves the labelled sample on the insights screen; empty is off.
INSIGHTS_SAMPLE=

# mcp (DOORDASH_DEVELOPER_ID, DOORDASH_KEY_ID and DOORDASH_SIGNING_SECRET are above)
# Square sandbox (docs/designs/adapters.md §4). One sandbox account with two locations:
# both tokens hold the same sandbox access token; the location ids differ
# (Developer Console > sandbox account > Locations).
SQUARE_RETAIL_TOKEN=
SQUARE_RESTAURANT_TOKEN=
SQUARE_ENV=sandbox
SQUARE_RETAIL_LOCATION_ID=
SQUARE_RESTAURANT_LOCATION_ID=
MOCK_COURIER_STEP_SECONDS=20

# agents (agent-protocol §13)
OFFER_TTL_SECONDS=600
COURIER_QUOTE_TTL_SECONDS=120
A2A_DEMO_TIMEOUT_SECONDS=900
A2A_SEND_WAIT_SECONDS=10
A2A_MAX_REQUEST_BYTES=32768
A2A_RATE_PER_SECOND=10

# agents, api, mcp (agent-protocol §13)
SHORTFALL_REPLY_SECONDS=900
SHORTFALL_MAX_LINES=3

# agents, testrunner. Static bearer token for the internal A2A endpoint.
A2A_DEMO_TOKEN=change-me-local

# testrunner
AGENTS_URL=http://agents:8003
# Demo phone numbers for the US seed. No real numbers in the repository.
SEED_US1_PHONES=

# caddy (control panel basic auth; the /panel route uses it from build step 6)
PANEL_USER=
PANEL_PASSWORD_HASH=

# deploy.sh and backup.sh only; not passed to containers
APP_IMAGE=ghcr.io/street-spinach/kitchenless-app
APP_TAG=local
GHCR_READ_TOKEN=
GCS_BACKUP_BUCKET=
