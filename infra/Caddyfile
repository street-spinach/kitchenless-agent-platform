# Public entry point. Caddy is the only service with public ports (80 and 443); everything else
# is reached through these routes or bound to 127.0.0.1 (see docker-compose.yml).
#
# DOMAIN comes from infra/.env. DOMAIN=localhost uses Caddy's internal CA (self-signed, so use
# curl -k); a real domain whose DNS points at the VM gets a public Let's Encrypt cert.
{$DOMAIN:localhost} {
	encode gzip

	# Liveness for smoke tests and deploy verification (tests/smoke, infra/deploy.sh).
	handle /health {
		reverse_proxy api:8000
	}
	# Placeholder hello flow: POST /hello/run on api writes trace rows (architecture item 31).
	handle /hello* {
		reverse_proxy api:8000
	}
	# Meta's WhatsApp webhook: verify challenge and signed messages (architecture item 34).
	handle /webhooks/whatsapp {
		reverse_proxy api:8000
	}
	# Owner app backend on api (architecture item 57; identity-authz I-A14, routes/app.py).
	handle /app/* {
		reverse_proxy api:8000
	}
	# The owner app's web export, served by api (experience EX-I45).
	redir /owner /owner/
	handle /owner/* {
		reverse_proxy api:8000
	}
	# Magic-link, consent and history pages on api (architecture item 57; identity-authz I-A14, routes/me.py).
	handle /me/* {
		reverse_proxy api:8000
	}
	# Control panel routes on api, behind basic auth (architecture items 39 and 57).
	# PANEL_USER and PANEL_PASSWORD_HASH come from docker-compose.yml.
	handle /panel* {
		basic_auth {
			{$PANEL_USER} {$PANEL_PASSWORD_HASH}
		}
		reverse_proxy api:8000
	}
	# Keycloak, served under /auth (identity-authz I17): only the kitchenless realm and the
	# static resources its pages load. The admin console, the master realm and every other
	# /auth path are 404 (tests/smoke test_keycloak_admin_not_public).
	handle /auth/realms/kitchenless/* {
		reverse_proxy keycloak:8080
	}
	handle /auth/resources/* {
		reverse_proxy keycloak:8080
	}
	handle /auth/* {
		respond 404
	}
	# Anything else is not routed. In particular /internal/*, /runs*, /mcp* and the agents
	# service's /a2a endpoint stay private (tests/smoke test_internal_routes_not_public).
	# /webhooks/doordash/* stays unrouted until a real courier exists (adapters amendment,
	# 2026-11-02).
	handle {
		respond "Not found" 404
	}
}
