{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(cd *)",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(diff *)",
      "Bash(echo *)",
      "Bash(jq *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(chmod +x *)",
      "Bash(sleep *)",

      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git push -u origin issue-*)",
      "Bash(git push origin issue-*)",
      "Bash(git push)",
      "Bash(git stash *)",
      "Bash(git restore *)",
      "Bash(git rm *)",

      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue create *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",

      "Bash(make *)",
      "Bash(uv *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(pytest *)",
      "Bash(ruff *)",
      "Bash(docker compose *)",
      "Bash(docker ps *)",
      "Bash(docker logs *)",
      "Bash(docker exec *)",
      "Bash(curl http://localhost*)",
      "Bash(curl -s http://localhost*)",

      "WebSearch",
      "WebFetch(domain:docs.python.org)",
      "WebFetch(domain:langchain-ai.github.io)",
      "WebFetch(domain:openfga.dev)",
      "WebFetch(domain:www.keycloak.org)",
      "WebFetch(domain:developer.squareup.com)",
      "WebFetch(domain:developer.doordash.com)",
      "WebFetch(domain:developer.kroger.com)",
      "WebFetch(domain:docs.instacart.com)",
      "WebFetch(domain:world.openfoodfacts.org)",
      "WebFetch(domain:dev.meta.ai)",
      "WebFetch(domain:neo4j.com)",
      "WebFetch(domain:redis.io)",
      "WebFetch(domain:github.com)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git rebase *)",
      "Bash(git commit --no-verify*)",

      "Bash(gh pr merge *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr review *)",
      "Bash(gh api *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh label *)",
      "Bash(gh repo *)",
      "Bash(gh workflow *)",
      "Bash(gh auth *)",

      "Bash(sudo *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(gcloud *)",
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/id_ed25519*)",
      "Edit(.env)",
      "Edit(.env.local)",
      "Edit(.claude/**)",


      "Bash(rm -rf /*)",
      "Bash(docker system prune *)",
      "Bash(docker volume rm *)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.sh"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "egm": {
      "source": { "source": "github", "repo": "google/elephant-goldfish-model" }
    }
  },
  "enabledPlugins": {
    "egm@egm": true
  }
}
